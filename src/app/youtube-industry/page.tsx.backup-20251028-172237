import { Metadata } from 'next'
import { ytSupabase } from '@/lib/youtube-supabase/client'
import { ErrorBoundary } from '@/components/ErrorBoundary'
import Link from 'next/link'

export const metadata: Metadata = {
  title: '유튜브 산업지수 | The Founder',
  description: 'Y코드 산업별 유튜브 채널 트렌드와 영상당 조회수 분석 대시보드',
  openGraph: {
    title: '유튜브 산업지수',
    description: 'Y코드 산업별 유튜브 채널 트렌드와 영상당 조회수 분석 대시보드',
    type: 'website'
  }
}

// ✅ CRITICAL: 캐싱 완전 비활성화
export const dynamic = 'force-dynamic'
export const revalidate = 0
export const fetchCache = 'force-no-store'

export default async function YouTubeIndustryPage() {
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
  console.log('📊 [YouTube Industry Page] Server rendering...')
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

  try {
    // Step 1: 카테고리 데이터
    const { data: categories, error: categoriesError } = await ytSupabase
      .from('youtube_categories')
      .select('*')
      .order('code', { ascending: true })

    console.log(`📦 Categories:`, {
      count: categories?.length || 0,
      error: categoriesError ? 'YES' : 'NO',
    })

    // Step 2: 채널 데이터 (✅ 실제 DB 컬럼명 사용)
    const { data: channels, error: channelsError } = await ytSupabase
      .from('youtube_channels')
      .select('*')
      .order('subscribers', { ascending: false })  // ✅ subscribers!

    console.log(`📦 Channels:`, {
      count: channels?.length || 0,
      error: channelsError ? 'YES' : 'NO',
    })

    // Step 3: 에러 처리
    if (categoriesError || channelsError) {
      console.error('❌ Error:', { categoriesError, channelsError })

      return (
        <ErrorBoundary>
          <div className="container mx-auto p-6">
            <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
              <h2 className="font-bold text-xl mb-2">데이터를 불러오는 중 오류가 발생했습니다.</h2>
              {categoriesError && (
                <div className="bg-red-50 p-3 rounded mt-2">
                  <p className="font-mono text-sm">카테고리 에러: {categoriesError.message}</p>
                </div>
              )}
              {channelsError && (
                <div className="bg-red-50 p-3 rounded mt-2">
                  <p className="font-mono text-sm">채널 에러: {channelsError.message}</p>
                </div>
              )}
              <p className="text-sm mt-3">
                💡 Hint: <code>node scripts/check-db-schema.js</code>로 DB 스키마 확인
              </p>
            </div>
          </div>
        </ErrorBoundary>
      )
    }

    // Step 4: 데이터 없음 처리
    if (!categories || categories.length === 0 || !channels || channels.length === 0) {
      return (
        <ErrorBoundary>
          <div className="container mx-auto p-6">
            <div className="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
              <h2 className="font-bold text-xl mb-2">데이터 없음</h2>
              <p>아직 데이터가 없습니다.</p>
              <p className="text-sm mt-2">먼저 채널을 추가해주세요.</p>
            </div>
          </div>
        </ErrorBoundary>
      )
    }

    // Step 5: 카테고리별 통계 계산 (✅ 실제 DB 컬럼명 사용)
    const stats = categories.map(category => {
      const categoryChannels = channels.filter(
        ch => ch.category_code === category.code
      )

      const totalSubscribers = categoryChannels.reduce(
        (sum, ch) => sum + (ch.subscribers || 0),  // ✅ subscribers
        0
      )

      const totalViews = categoryChannels.reduce(
        (sum, ch) => sum + (ch.total_views || 0),  // ✅ total_views
        0
      )

      return {
        ...category,
        channelCount: categoryChannels.length,
        totalSubscribers,
        totalViews,
      }
    })

    const totalChannels = channels.length
    const totalSubscribers = channels.reduce(
      (sum, ch) => sum + (ch.subscribers || 0),
      0
    )
    const totalViews = channels.reduce(
      (sum, ch) => sum + (ch.total_views || 0),
      0
    )

    // 우낌표 채널 확인
    const wooxmall = channels.find(
      ch => ch.name?.includes('우낌표')
    )

    if (wooxmall) {
      console.log(`🔍 우낌표 채널: ${wooxmall.name} = ${wooxmall.category_code}`)
    }

    console.log('✅ Stats calculated, rendering UI...')
    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

    // Step 6: 직접 렌더링
    return (
      <ErrorBoundary>
        <div className="min-h-screen bg-gray-50 dark:bg-gray-900">
          {/* Header */}
          <header className="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-10">
            <div className="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
              <div className="flex flex-col md:flex-row md:items-center md:justify-between">
                <div>
                  <h1 className="text-3xl font-bold text-gray-900 dark:text-white">
                    유튜브 산업지수
                  </h1>
                  <p className="mt-1 text-sm text-gray-600 dark:text-gray-400">
                    Y코드 산업별 채널 트렌드 및 영상당 조회수 분석
                  </p>
                </div>

                <div className="mt-4 md:mt-0 flex items-center gap-3">
                  <div className="flex items-center gap-2 text-sm">
                    <div className="flex items-center gap-1">
                      <div className="w-3 h-3 rounded-sm bg-green-600"></div>
                      <span className="text-gray-600 dark:text-gray-400">상승</span>
                    </div>
                    <div className="flex items-center gap-1">
                      <div className="w-3 h-3 rounded-sm bg-red-600"></div>
                      <span className="text-gray-600 dark:text-gray-400">하락</span>
                    </div>
                    <div className="flex items-center gap-1">
                      <div className="w-3 h-3 rounded-sm bg-gray-400"></div>
                      <span className="text-gray-600 dark:text-gray-400">보합</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </header>

          {/* Main Dashboard */}
          <main className="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {/* 전체 통계 */}
            <div className="mb-8">
              <h2 className="text-xl font-bold mb-4 text-gray-900 dark:text-white">시장 개요</h2>
              <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                  <div className="text-sm text-gray-600 dark:text-gray-400">전체 채널</div>
                  <div className="text-3xl font-bold text-blue-600">
                    {totalChannels}
                  </div>
                  <div className="text-xs text-gray-500 mt-1">
                    {categories.length}개 카테고리
                  </div>
                </div>

                <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                  <div className="text-sm text-gray-600 dark:text-gray-400">API 사용량</div>
                  <div className="text-3xl font-bold text-purple-600">
                    {totalChannels} / 10000
                  </div>
                  <div className="text-xs text-gray-500 mt-1">
                    {((totalChannels / 10000) * 100).toFixed(1)}% 사용
                  </div>
                </div>

                <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                  <div className="text-sm text-gray-600 dark:text-gray-400">총 구독자</div>
                  <div className="text-3xl font-bold text-green-600">
                    {(totalSubscribers / 1000000).toFixed(1)}M
                  </div>
                  <div className="text-xs text-gray-500 mt-1">전체 채널 합계</div>
                </div>

                <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                  <div className="text-sm text-gray-600 dark:text-gray-400">총 조회수</div>
                  <div className="text-3xl font-bold text-orange-600">
                    {totalViews === 0 ? 'N/A' : (totalViews / 1000000000).toFixed(1) + 'B'}
                  </div>
                  <div className="text-xs text-gray-500 mt-1">전체 채널 합계</div>
                </div>
              </div>
            </div>

            {/* 산업별 트렌드 */}
            <div className="mb-8">
              <h2 className="text-xl font-bold mb-4 text-gray-900 dark:text-white">산업별 트렌드</h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                {stats
                  .filter(stat => stat.channelCount > 0)
                  .slice(0, 9)
                  .map(stat => (
                    <Link
                      key={stat.code}
                      href={`/youtube-industry/${stat.code}`}
                      className="bg-white dark:bg-gray-800 p-4 rounded-lg shadow hover:shadow-lg transition cursor-pointer"
                    >
                      <div className="flex items-center gap-3 mb-3">
                        <span className="text-3xl">{stat.icon}</span>
                        <div>
                          <div className="font-bold text-lg text-gray-900 dark:text-white">{stat.name}</div>
                          <div className="text-sm text-gray-600 dark:text-gray-400">
                            {stat.channelCount}개 채널
                          </div>
                        </div>
                      </div>
                      <div className="grid grid-cols-2 gap-2 text-sm">
                        <div>
                          <div className="text-gray-600 dark:text-gray-400">구독자</div>
                          <div className="font-semibold text-gray-900 dark:text-white">
                            {(stat.totalSubscribers / 1000000).toFixed(1)}M
                          </div>
                        </div>
                        <div>
                          <div className="text-gray-600 dark:text-gray-400">조회수</div>
                          <div className="font-semibold text-gray-900 dark:text-white">
                            {stat.totalViews === 0 ? 'N/A' : (stat.totalViews / 1000000000).toFixed(1) + 'B'}
                          </div>
                        </div>
                      </div>
                    </Link>
                  ))}
              </div>
            </div>

            {/* 산업 순위 */}
            <div className="mb-8">
              <h2 className="text-xl font-bold mb-4 text-gray-900 dark:text-white">산업 순위</h2>
              <div className="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
                <table className="w-full">
                  <thead className="bg-gray-50 dark:bg-gray-900">
                    <tr>
                      <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                        순위
                      </th>
                      <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                        산업
                      </th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                        채널 수
                      </th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                        총 구독자
                      </th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                        총 조회수
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
                    {stats
                      .filter(stat => stat.channelCount > 0)
                      .sort((a, b) => b.totalSubscribers - a.totalSubscribers)
                      .map((stat, index) => (
                        <tr key={stat.code} className="hover:bg-gray-50 dark:hover:bg-gray-900/50">
                          <td className="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white">
                            #{index + 1}
                          </td>
                          <td className="px-6 py-4">
                            <Link
                              href={`/youtube-industry/${stat.code}`}
                              className="flex items-center gap-2 hover:text-blue-600"
                            >
                              <span className="text-xl">
                                {stat.icon}
                              </span>
                              <span className="font-medium text-gray-900 dark:text-white">{stat.name}</span>
                            </Link>
                          </td>
                          <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                            {stat.channelCount}개
                          </td>
                          <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                            {(stat.totalSubscribers / 1000000).toFixed(1)}M
                          </td>
                          <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                            {stat.totalViews === 0 ? 'N/A' : (stat.totalViews / 1000000000).toFixed(2) + 'B'}
                          </td>
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* 디버깅 정보 (개발 모드) */}
            {process.env.NODE_ENV === 'development' && (
              <div className="mt-6 p-4 bg-gray-100 dark:bg-gray-900 rounded border border-gray-300 dark:border-gray-700">
                <h3 className="font-bold mb-2 text-gray-900 dark:text-white">🔍 Debug Info:</h3>
                <pre className="text-xs overflow-auto text-gray-800 dark:text-gray-200 max-h-40">
                  {JSON.stringify(
                    {
                      categoriesCount: categories.length,
                      channelsCount: channels.length,
                      statsCount: stats.length,
                      totalSubscribers: (totalSubscribers / 1000000).toFixed(1) + 'M',
                      totalViews: totalViews === 0 ? 'N/A' : (totalViews / 1000000000).toFixed(1) + 'B',
                      우낌표Channel: wooxmall
                        ? {
                            name: wooxmall.name,
                            category: wooxmall.category_code,
                          }
                        : null,
                    },
                    null,
                    2
                  )}
                </pre>
              </div>
            )}
          </main>

          {/* Footer Info */}
          <footer className="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-12">
            <div className="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
              <div className="text-center text-sm text-gray-600 dark:text-gray-400">
                <p>
                  데이터는 매일 업데이트되며, 영상당 조회수를 기준으로 산업 규모를 측정합니다.
                </p>
                <p className="mt-1">
                  사각형 크기 = 평균 영상당 조회수 | 색상 = 일간 변화율
                </p>
              </div>
            </div>
          </footer>
        </div>
      </ErrorBoundary>
    )
  } catch (error) {
    console.error('❌ Fatal Error:', error)

    return (
      <ErrorBoundary>
        <div className="container mx-auto p-6">
          <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <h2 className="font-bold text-xl mb-2">심각한 오류</h2>
            <p>{error instanceof Error ? error.message : '알 수 없는 오류'}</p>
          </div>
        </div>
      </ErrorBoundary>
    )
  }
}
