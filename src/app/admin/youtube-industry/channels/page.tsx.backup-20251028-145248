/**
 * YouTube Industry Channels Management Page (Server Component)
 * 채널 관리 페이지 - 실제 DB 컬럼명 사용
 */

import { ytSupabase } from '@/lib/youtube-supabase/client'
import Link from 'next/link'

// ✅ CRITICAL: 캐싱 완전 비활성화
export const dynamic = 'force-dynamic'
export const revalidate = 0
export const fetchCache = 'force-no-store'

export default async function AdminChannelsPage() {
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')
  console.log('🔄 [Admin Channels Page] Server rendering...')
  console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

  try {
    // ✅ 실제 DB 컬럼명 사용: subscribers, total_views, video_count, views_per_video
    const { data: channels, error: channelsError } = await ytSupabase
      .from('youtube_channels')
      .select('*')
      .order('subscribers', { ascending: false })  // ✅ subscriber_count가 아니라 subscribers!

    console.log(`📦 Fetched channels:`, {
      count: channels?.length || 0,
      error: channelsError ? 'YES' : 'NO',
      errorMessage: channelsError?.message || 'none',
      sample: channels?.[0] ? {
        id: channels[0].channel_id,
        name: channels[0].name,
        subscribers: channels[0].subscribers,
        category: channels[0].category_code
      } : 'no data'
    })

    const { data: categories, error: categoriesError } = await ytSupabase
      .from('youtube_categories')
      .select('*')
      .order('code', { ascending: true })

    console.log(`📦 Fetched categories:`, {
      count: categories?.length || 0,
      error: categoriesError ? 'YES' : 'NO',
    })

    // 에러 처리
    if (channelsError || categoriesError) {
      console.error('❌ Database error:', {
        channelsError,
        categoriesError
      })

      return (
        <div className="container mx-auto p-6">
          <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
            <h2 className="font-bold text-xl mb-2">데이터베이스 오류</h2>
            <p className="mb-2">채널 데이터를 불러올 수 없습니다.</p>
            {channelsError && (
              <div className="bg-red-50 p-3 rounded mt-2">
                <p className="font-mono text-sm">{channelsError.message}</p>
              </div>
            )}
            {categoriesError && (
              <div className="bg-red-50 p-3 rounded mt-2">
                <p className="font-mono text-sm">{categoriesError.message}</p>
              </div>
            )}
            <p className="text-sm mt-3">
              💡 Hint: DB 스키마를 확인하세요. <code>node scripts/check-db-schema.js</code>
            </p>
          </div>
        </div>
      )
    }

    // 데이터 없음 처리
    if (!channels || channels.length === 0) {
      console.warn('⚠️ No channels found in database!')

      return (
        <div className="container mx-auto p-6">
          <div className="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
            <h2 className="font-bold text-xl mb-2">데이터 없음</h2>
            <p>데이터베이스에 채널이 없습니다.</p>
            <p className="text-sm mt-2">먼저 채널을 추가해주세요.</p>
          </div>
        </div>
      )
    }

    // ✅ 통계 계산 (실제 DB 컬럼명 사용)
    const totalSubscribers = channels.reduce(
      (sum, ch) => sum + (ch.subscribers || 0),  // ✅ subscribers
      0
    )
    const totalViews = channels.reduce(
      (sum, ch) => sum + (ch.total_views || 0),  // ✅ total_views
      0
    )

    // 우낌표 채널 확인
    const wooxmall = channels.find(
      ch => ch.name?.includes('우낌표')
    )

    if (wooxmall) {
      console.log('🔍 우낌표 채널 상태:', {
        id: wooxmall.channel_id,
        name: wooxmall.name,
        category: wooxmall.category_code,
        subscribers: wooxmall.subscribers
      })
    }

    console.log('✅ Data ready, rendering UI...')
    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━')

    return (
      <div className="container mx-auto p-6">
        {/* 헤더 */}
        <div className="mb-6">
          <h1 className="text-2xl font-bold">📺 채널 관리</h1>
          <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">
            총 {channels.length}개 채널
          </p>
        </div>

        {/* 통계 카드 */}
        <div className="grid grid-cols-4 gap-4 mb-6">
          <div className="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
            <div className="text-sm text-gray-600 dark:text-gray-400">전체 채널</div>
            <div className="text-2xl font-bold text-blue-600">
              {channels.length}개
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
            <div className="text-sm text-gray-600 dark:text-gray-400">카테고리</div>
            <div className="text-2xl font-bold text-purple-600">
              {categories?.length || 0}개
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
            <div className="text-sm text-gray-600 dark:text-gray-400">총 구독자</div>
            <div className="text-2xl font-bold text-green-600">
              {(totalSubscribers / 1000000).toFixed(1)}M
            </div>
          </div>
          <div className="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
            <div className="text-sm text-gray-600 dark:text-gray-400">총 조회수</div>
            <div className="text-2xl font-bold text-orange-600">
              {totalViews === 0 ? 'N/A' : (totalViews / 1000000000).toFixed(1) + 'B'}
            </div>
          </div>
        </div>

        {/* 채널 테이블 */}
        <div className="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
          <table className="w-full">
            <thead className="bg-gray-50 dark:bg-gray-900">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  #
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  채널명
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  카테고리
                </th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  구독자
                </th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  영상 수
                </th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">
                  영상당 조회수
                </th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200 dark:divide-gray-700">
              {channels.slice(0, 100).map((channel, index) => {
                const category = categories?.find(
                  cat => cat.code === channel.category_code
                )

                return (
                  <tr key={channel.channel_id} className="hover:bg-gray-50 dark:hover:bg-gray-900/50">
                    <td className="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                      {index + 1}
                    </td>
                    <td className="px-6 py-4">
                      <div className="font-medium text-gray-900 dark:text-white">
                        {channel.name || '(이름 없음)'}
                      </div>
                      <div className="text-xs text-gray-500 dark:text-gray-400">
                        {channel.channel_id}
                      </div>
                    </td>
                    <td className="px-6 py-4">
                      <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                        {category?.icon || '❓'}{' '}
                        {category?.name || channel.category_code}
                      </span>
                    </td>
                    <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                      {(channel.subscribers || 0).toLocaleString()}
                    </td>
                    <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                      {(channel.video_count || 0).toLocaleString()}
                    </td>
                    <td className="px-6 py-4 text-right text-sm text-gray-900 dark:text-white">
                      {channel.views_per_video
                        ? channel.views_per_video.toLocaleString()
                        : '-'}
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>

        {/* 푸터 */}
        <div className="mt-4 text-sm text-gray-500 dark:text-gray-400">
          표시 중: {Math.min(100, channels.length)}개 / 전체: {channels.length}개
        </div>

        {/* 디버깅 정보 (개발 모드) */}
        {process.env.NODE_ENV === 'development' && (
          <div className="mt-6 p-4 bg-gray-100 dark:bg-gray-900 rounded border border-gray-300 dark:border-gray-700">
            <h3 className="font-bold mb-2">🔍 Debug Info:</h3>
            <pre className="text-xs overflow-auto max-h-60">
              {JSON.stringify(
                {
                  totalChannels: channels.length,
                  totalCategories: categories?.length,
                  sampleChannel: {
                    id: channels[0]?.channel_id,
                    name: channels[0]?.name,
                    subscribers: channels[0]?.subscribers,
                    total_views: channels[0]?.total_views,
                    video_count: channels[0]?.video_count,
                    category: channels[0]?.category_code,
                  },
                  우낌표Channel: wooxmall
                    ? {
                        name: wooxmall.name,
                        category: wooxmall.category_code,
                        subscribers: wooxmall.subscribers,
                      }
                    : null,
                  totalStats: {
                    subscribers: (totalSubscribers / 1000000).toFixed(1) + 'M',
                    views: totalViews === 0 ? 'N/A' : (totalViews / 1000000000).toFixed(1) + 'B',
                  }
                },
                null,
                2
              )}
            </pre>
          </div>
        )}
      </div>
    )
  } catch (error) {
    console.error('❌ Fatal Error:', error)

    return (
      <div className="container mx-auto p-6">
        <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <h2 className="font-bold text-xl mb-2">심각한 오류</h2>
          <p>{error instanceof Error ? error.message : '알 수 없는 오류'}</p>
        </div>
      </div>
    )
  }
}
