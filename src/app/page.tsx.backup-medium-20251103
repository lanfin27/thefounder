import { createClient } from '@supabase/supabase-js'
import { Metadata } from 'next'
import HeroSectionNew from '@/components/home/HeroSectionNew'
import FeaturedContentSection from '@/components/home/FeaturedContentSection'
import CategorySectionNew from '@/components/home/CategorySectionNew'
import NewsletterSectionNew from '@/components/home/NewsletterSectionNew'

export const revalidate = 3600

export const metadata: Metadata = {
  title: 'The Founder - 한국 1인 창업가를 위한 인사이트',
  description: '실제로 성공한 1인 창업가들의 이야기와 인사이트, 기술 트렌드를 모두 한 곳에서',
  keywords: ['창업', '1인 창업', '스타트업', '인사이트', 'SaaS', '트렌드'],
  openGraph: {
    title: 'The Founder - 한국 1인 창업가를 위한 인사이트',
    description: '실제로 성공한 1인 창업가들의 이야기와 인사이트를 만나보세요',
    images: ['/og-image.jpg'],
  },
}

export default async function HomePage() {
  const supabase = createClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
  )

  // 각 카테고리별 최신 포스트 가져오기
  const [trendPosts, insightPosts, casePosts, blogPosts] = await Promise.all([
    // 트렌드 포스트
    supabase
      .from('posts')
      .select('*')
      .eq('category', 'trend')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(4)
      .then(({ data }) => data || []),

    // 인사이트 포스트
    supabase
      .from('posts')
      .select('*')
      .eq('category', 'insight')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(3)
      .then(({ data }) => data || []),

    // 사례 포스트
    supabase
      .from('posts')
      .select('*')
      .eq('category', 'casestudy')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(2)
      .then(({ data }) => data || []),

    // 블로그 포스트
    supabase
      .from('posts')
      .select('*')
      .eq('category', 'blog')
      .eq('status', 'published')
      .order('published_at', { ascending: false })
      .limit(2)
      .then(({ data }) => data || []),
  ])

  return (
    <main>
      {/* Hero Section */}
      <HeroSectionNew />

      {/* Featured Content */}
      <FeaturedContentSection />

      {/* 트렌드 섹션 */}
      {trendPosts.length > 0 && (
        <CategorySectionNew
          title="트렌드"
          description="1분 안에 파악하는 1인 창업 트렌드"
          emoji="🔥"
          posts={trendPosts}
          category="trend"
          columns={4}
        />
      )}

      {/* 인사이트 섹션 */}
      {insightPosts.length > 0 && (
        <CategorySectionNew
          title="인사이트"
          description="성공한 창업가들의 생생한 이야기"
          emoji="🎬"
          posts={insightPosts}
          category="insight"
          columns={3}
        />
      )}

      {/* 사례 섹션 */}
      {casePosts.length > 0 && (
        <CategorySectionNew
          title="사례"
          description="국내외 1인 창업 성공 스토리"
          emoji="📚"
          posts={casePosts}
          category="casestudy"
          columns={2}
        />
      )}

      {/* 블로그 섹션 */}
      {blogPosts.length > 0 && (
        <CategorySectionNew
          title="블로그"
          description="창업가들의 실전 경험 공유"
          emoji="✍️"
          posts={blogPosts}
          category="blog"
          columns={2}
        />
      )}

      {/* Newsletter Section */}
      <NewsletterSectionNew />
    </main>
  )
}
