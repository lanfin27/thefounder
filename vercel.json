{
  "buildCommand": "rm -rf .next/cache && next build",
  "functions": {
    "api/**/*.{js,ts}": {
      "maxDuration": 60
    },
    "api/admin/**/*.{js,ts}": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/youtube-smart-update/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/youtube-smart-update",
      "schedule": "0 3 * * *"
    }
  ]
}
